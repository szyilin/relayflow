<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.relayflow.module.infra.dal.mapper.InfraGeoRegionExtMapper">

    <select id="countChildrenByParentIds" resultType="java.util.HashMap">
        SELECT parent_id AS parentId, COUNT(*) AS childCount
        FROM infra_geo_region
        WHERE deleted = 0
          AND parent_id IN
        <foreach collection="parentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY parent_id
    </select>

</mapper>

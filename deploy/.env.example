# Copy to deploy/.env and adjust for local development.
# 开发：deploy/compose.yml（仅基础设施）
# 部署：deploy/compose.prod.yml（基础设施 + relayflow-server 容器）

POSTGRES_DB=relayflow
POSTGRES_USER=relayflow
POSTGRES_PASSWORD=relayflow
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 后端 API（容器映射到宿主机；前端 pnpm dev 通过 Vite 代理访问）
SERVER_PORT=8080

# Application (relayflow-server) and codegen CLI (scripts/codegen.sh)
# 本机 mvn/spring-boot:run 时使用 localhost；Docker Compose 内 server 服务用 postgres/redis/minio 主机名。
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/relayflow
SPRING_REDIS_HOST=localhost
RELAYFLOW_CACHE_ENABLED=true
RELAYFLOW_MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Object storage bootstrap (relayflow.storage.*)
RELAYFLOW_STORAGE_DEFAULT_PROVIDER=minio
RELAYFLOW_STORAGE_VALIDATE_ON_STARTUP=true
RELAYFLOW_STORAGE_MINIO_BUCKET=relayflow

# Tenant (V1 default: single-tenant self-hosted; V2: multi-tenant product mode)
# | 模式 | RELAYFLOW_TENANT_ENABLED | RELAYFLOW_TENANT_ALLOW_OPEN_REGISTER |
# |------|--------------------------|--------------------------------------|
# | V1 自托管（默认） | false | false |
# | V2 多租户 SaaS | true | true |
# 本地 `spring-boot:run` 默认 profile=dev 已在 application-dev.yml 启用 V2；Docker 部署见 compose.prod.yml。
RELAYFLOW_TENANT_ENABLED=false
RELAYFLOW_TENANT_DEFAULT_ID=1
RELAYFLOW_TENANT_ALLOW_OPEN_REGISTER=false
RELAYFLOW_JWT_SECRET=dev-only-change-me-in-production

# AES-256 key for encrypting tenant storage secrets (Base64, 32 raw bytes)
RELAYFLOW_ENCRYPT_AES_KEY=cmVsYXlmbG93LWRldi1hZXMta2V5LWNoYW5nZS1tZSE=

# XXL-JOB Admin（共用 Compose Postgres，独立库 xxl_job；种子见 deploy/xxl-job/）
# UI: http://localhost:8090/xxl-job-admin  默认账号 admin / 123456
XXL_JOB_ADMIN_PORT=8090
XXL_JOB_DB_NAME=xxl_job
XXL_JOB_ACCESS_TOKEN=relayflow-dev-xxl-token

# 宿主机 spring-boot:run 内嵌执行器（Admin 在 Docker 时建议设置 IP）
RELAYFLOW_JOB_ENABLED=true
RELAYFLOW_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8090/xxl-job-admin
RELAYFLOW_JOB_ACCESS_TOKEN=relayflow-dev-xxl-token
RELAYFLOW_JOB_EXECUTOR_APPNAME=relayflow-server
RELAYFLOW_JOB_EXECUTOR_PORT=9999
# Admin-in-Docker 回调宿主机执行器：用 address（勿填无法解析的 IP 主机名，避免 XXL 启动 NPE）
RELAYFLOW_JOB_EXECUTOR_ADDRESS=http://host.docker.internal:9999/
RELAYFLOW_JOB_EXECUTOR_IP=
